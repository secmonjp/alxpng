package main

import (
	"bufio"
	"crypto/tls"
	"flag"
	"fmt"
	"math/rand"
	"net"
	"net/http"
	"os"
	"strings"
	"sync"
	"sync/atomic"
	"time"
)

// Global Shared Tracking States
var (
	successCount  int64
	failedCount   int64
	totalCount    int64
	latencies     []float64
	latencyLock   sync.Mutex
	running       bool = true
	customHeaders = make(map[string]string)
	headerLock    sync.RWMutex
)

var userAgents = []string{
	"Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
	"Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)",
	"Mozilla/5.0 (X11; Linux x86_64)",
}

func loadCustomHeaders(filePath string) {
	if filePath == "" {
		return
	}
	file, err := os.Open(filePath)
	if err != nil {
		fmt.Printf("[!] Failed loading header file: %v\n", err)
		return
	}
	defer file.Close()

	headerLock.Lock()
	defer headerLock.Unlock()

	scanner := bufio.NewScanner(file)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		if strings.Contains(line, ":") {
			parts := strings.SplitN(line, ":", 2)
			key := strings.TrimSpace(parts[0])
			val := strings.TrimSpace(parts[1])
			customHeaders[key] = val
		}
	}
	fmt.Printf("[+] Loaded custom headers: %d\n", len(customHeaders))
}

func main() {
	// Replicates your Python CLI parameter parser precisely
	mode := flag.String("mode", "", "Choices: http, https, tcp, udp, ssh")
	host := flag.String("host", "", "Target host string")
	path := flag.String("path", "/", "Target path string")
	headerFile := flag.String("header-file", "", "Custom headers source text file")
	port := flag.Int("port", 0, "Network target destination port")
	threads := flag.Int("threads", 100, "Thread capacity index")
	duration := flag.Int("duration", 30, "Operational cycle timer threshold")
	size := flag.Int("size", 512, "Payload packet weight threshold")
	flag.Parse()

	if *mode == "" || *host == "" {
		fmt.Println("[!] Error: -mode and -host are required.")
		os.Exit(1)
	}

	if *port == 0 && strings.ToLower(*mode) == "ssh" {
		*port = 22
	}

	if *headerFile != "" {
		loadCustomHeaders(*headerFile)
	}

	payload := make([]byte, *size)
	for i := range payload {
		payload[i] = 'A'
	}

	fmt.Println("===================================")
	fmt.Println(" Unified Test Engine (Hybrid Go)")
	fmt.Println("===================================")
	fmt.Printf("Mode     : %s\n", *mode)
	fmt.Printf("Host     : %s\n", *host)
	if *port != 0 {
		fmt.Printf("Port     : %d\n", *port)
	}
	fmt.Printf("Threads  : %d\n", *threads)
	fmt.Printf("Duration : %d\n", *duration)
	fmt.Println("===================================")

	var workerFunc func(string, int, string, string, []byte)
	switch strings.ToLower(*mode) {
	case "http", "https":
		workerFunc = httpWorker
	case "tcp":
		workerFunc = tcpWorker
	case "udp":
		workerFunc = udpWorker
	case "ssh":
		workerFunc = sshWorker
	default:
		fmt.Printf("[!] Unsupported mode parameter: %s\n", *mode)
		os.Exit(1)
	}

	rand.Seed(time.Now().UnixNano())

	var wg sync.WaitGroup
	for i := 0; i < *threads; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			workerFunc(*mode, *port, *host, *path, payload)
		}()
	}

	go monitorLoop(*duration)

	wg.Wait()
	fmt.Printf("\nFinished. Total: %d\n", atomic.LoadInt64(&totalCount))
}

// ==========================================
// TRANSLATED PYTHON TARGET WORKERS
// ==========================================

func httpWorker(mode, port int, host, path string, payload []byte) {
	transport := &http.Transport{
		TLSClientConfig: &tls.Config{InsecureSkipVerify: true},
	}
	client := &http.Client{
		Timeout:   5 * time.Second,
		Transport: transport,
	}

	cleanPath := path
	if !strings.HasPrefix(cleanPath, "/") {
		cleanPath = "/" + cleanPath
	}

	for running {
		randID := rand.Intn(900000) + 100000
		var url string
		if port == 0 || port == 80 || port == 443 {
			url = fmt.Sprintf("%s://%s%s?%d", mode, host, cleanPath, randID)
		} else {
			url = fmt.Sprintf("%s://%s:%d%s?%d", mode, host, port, cleanPath, randID)
		}

		req, err := http.NewRequest("GET", url, nil)
		if err != nil {
			atomic.AddInt64(&failedCount, 1)
			atomic.AddInt64(&totalCount, 1)
			continue
		}

		// Inject Default Headers
		req.Header.Set("User-Agent", userAgents[rand.Intn(len(userAgents))])
		req.Header.Set("Accept", "text/html,application/xhtml+xml")
		req.Header.Set("Accept-Language", "en-US,en;q=0.9")
		req.Header.Set("Connection", "keep-alive")

		// Dynamic Custom Headers Overlay Injection
		headerLock.RLock()
		for k, v := range customHeaders {
			req.Header.Set(k, v)
		}
		headerLock.RUnlock()

		start := time.Now()
		resp, err := client.Do(req)
		elapsed := time.Since(start).Seconds()

		atomic.AddInt64(&totalCount, 1)
		if err != nil {
			atomic.AddInt64(&failedCount, 1)
		} else {
			if resp.StatusCode >= 200 && resp.StatusCode < 400 {
				atomic.AddInt64(&successCount, 1)
			} else {
				atomic.AddInt64(&failedCount, 1)
			}
			resp.Body.Close()

			latencyLock.Lock()
			if len(latencies) < 50000 { 
				latencies = append(latencies, elapsed)
			}
			latencyLock.Unlock()
		}
		// Exact replication of time.sleep(random.uniform(0.02, 0.08))
		sleepMs := rand.Float64()*(80-20) + 20
		time.Sleep(time.Duration(sleepMs) * time.Millisecond)
	}
}

func tcpWorker(mode string, port int, host, path string, payload []byte) {
	target := fmt.Sprintf("%s:%d", host, port)
	for running {
		start := time.Now()
		conn, err := net.DialTimeout("tcp", target, 3*time.Second)
		if err != nil {
			atomic.AddInt64(&totalCount, 1)
			atomic.AddInt64(&failedCount, 1)
			continue
		}

		_, err = conn.Write(payload)
		elapsed := time.Since(start).Seconds()
		conn.Close()

		atomic.AddInt64(&totalCount, 1)
		if err != nil {
			atomic.AddInt64(&failedCount, 1)
		} else {
			atomic.AddInt64(&successCount, 1)
			latencyLock.Lock()
			if len(latencies) < 50000 {
				latencies = append(latencies, elapsed)
			}
			latencyLock.Unlock()
		}
	}
}

func udpWorker(mode string, port int, host, path string, payload []byte) {
	target := fmt.Sprintf("%s:%d", host, port)
	conn, err := net.Dial("udp", target)
	if err != nil {
		return
	}
	defer conn.Close()

	for running {
		_, err := conn.Write(payload)
		atomic.AddInt64(&totalCount, 1)
		if err != nil {
			atomic.AddInt64(&failedCount, 1)
		} else {
			atomic.AddInt64(&successCount, 1)
		}
	}
}

func sshWorker(mode string, port int, host, path string, payload []byte) {
	target := fmt.Sprintf("%s:%d", host, port)
	banner := []byte("SSH-2.0-OpenSSH_8.2p1\r\n")

	for running {
		start := time.Now()
		conn, err := net.DialTimeout("tcp", target, 3*time.Second)
		if err != nil {
			atomic.AddInt64(&totalCount, 1)
			atomic.AddInt64(&failedCount, 1)
			continue
		}

		_, err = conn.Write(banner)
		if err == nil {
			buf := make([]byte, 1024)
			_ = conn.SetReadDeadline(time.Now().Add(1 * time.Second))
			_, _ = conn.Read(buf)
		}
		elapsed := time.Since(start).Seconds()
		conn.Close()

		atomic.AddInt64(&totalCount, 1)
		if err != nil {
			atomic.AddInt64(&failedCount, 1)
		} else {
			atomic.AddInt64(&successCount, 1)
			latencyLock.Lock()
			if len(latencies) < 50000 {
				latencies = append(latencies, elapsed)
			}
			latencyLock.Unlock()
		}
	}
}

// ==========================================
// UNIFIED TELEMETRY OUTPUT STREAM MONITOR
// ==========================================

func monitorLoop(durationSecs int) {
	startTime := time.Now()
	var prevTotal int64 = 0

	for time.Since(startTime).Seconds() < float64(durationSecs) {
		time.Sleep(1 * time.Second)

		currentTotal := atomic.LoadInt64(&totalCount)
		rate := currentTotal - prevTotal
		prevTotal = currentTotal

		var avgLatency float64 = 0
		latencyLock.Lock()
		if len(latencies) > 0 {
			sampleSize := 100
			if len(latencies) < sampleSize {
				sampleSize = len(latencies)
			}
			var sum float64 = 0
			for i := len(latencies) - sampleSize; i < len(latencies); i++ {
				sum += latencies[i]
			}
			avgLatency = sum / float64(sampleSize)
		}
		latencyLock.Unlock()

		// Prints text variables matching Python: ok=X fail=Y total=Z avg=A rate=B/sec
		fmt.Printf("[STATS] ok=%d fail=%d total=%d avg=%.3fs rate=%d/sec\n",
			atomic.LoadInt64(&successCount),
			atomic.LoadInt64(&failedCount),
			currentTotal,
			avgLatency,
			rate,
		)
	}
	running = false
}
